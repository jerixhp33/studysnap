{
  "crons": [
    {
      "path": "/api/cron/reminders?secret=REPLACE_WITH_YOUR_CRON_SECRET",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/streaks?secret=REPLACE_WITH_YOUR_CRON_SECRET",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/cleanup?secret=REPLACE_WITH_YOUR_CRON_SECRET",
      "schedule": "0 2 * * 0"
    }
  ],
  "functions": {
    "src/app/api/documents/process/route.ts":  { "maxDuration": 60 },
    "src/app/api/documents/reindex/route.ts":  { "maxDuration": 30 },
    "src/app/api/ai/summary/route.ts":          { "maxDuration": 60 },
    "src/app/api/ai/quiz/route.ts":             { "maxDuration": 60 },
    "src/app/api/ai/flashcards/route.ts":       { "maxDuration": 60 },
    "src/app/api/ai/tutor/route.ts":            { "maxDuration": 60 },
    "src/app/api/ai/study-plan/route.ts":       { "maxDuration": 60 },
    "src/app/api/ai/evaluate/route.ts":         { "maxDuration": 60 }
  }
}
